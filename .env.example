# Copy to .env.local for local development. On Vercel, set these in Settings → Environment Variables.

# --- Database (PostgreSQL) ---
# Added automatically when you connect Neon or Prisma Postgres from Vercel → Storage.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) URL used for migrations; Vercel's Neon integration provides it. Optional otherwise.
DATABASE_URL_UNPOOLED=""

# --- Auth.js (Google sign-in) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google  (and http://localhost:3000/... for local)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Liveblocks (realtime board content, cursors) ---
# Liveblocks dashboard → API keys → Secret key
LIVEBLOCKS_SECRET_KEY="sk_..."

# --- Photos in notes (Vercel Blob, private) ---
# Added automatically when you create a Blob store in Vercel → Storage.
# Leave empty locally: photos are then saved to ./.uploads
BLOB_READ_WRITE_TOKEN=""

# --- Local development only ---
# Name-only sign-in without Google (ignored on Vercel).
# AUTH_DEV_LOGIN=1
# Use the local Liveblocks server (`npm run liveblocks:dev`) instead of the cloud:
# LIVEBLOCKS_SECRET_KEY="sk_localdev"
# LIVEBLOCKS_BASE_URL="http://localhost:1153"
# NEXT_PUBLIC_LIVEBLOCKS_BASE_URL="http://localhost:1153"
